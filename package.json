{
  "name": "movies-api",
  "version": "1.0.0",
  "description": "API de películas (Express + PostgreSQL)",
  "main": "src/server.js",
  "type": "module",
  "scripts": {
    "dev": "node --watch src/server.js",
    "start": "node src/server.js",
    "db:setup": "psql $DATABASE_URL -f sql/schema.sql && psql $DATABASE_URL -f sql/seeds.sql",
    "db:schema": "psql $DATABASE_URL -f sql/schema.sql",
    "db:seeds": "psql $DATABASE_URL -f sql/seeds.sql",
    "test": "jest --runInBand --forceExit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "pg": "^8.13.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@babel/preset-env": "^7.28.5",
    "babel-jest": "^30.2.0",
    "jest": "^30.2.0",
    "supertest": "^7.1.4"
  }
}
